class Rifa {
    static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("=== RIFA DE LA FUNDACIÓN ===");
        System.out.println("1. Boleta Plata");
        System.out.println("2. Boleta Oro");
        System.out.println("3. Boleta Diamante");
        System.out.print("Seleccione el tipo de boleta (1-3): ");
        int tipo = sc.nextInt();

        System.out.print("Ingrese la cantidad de boletas: ");
        int cantidad = sc.nextInt();

        if (cantidad <= 0) {
            System.out.println("x La cantidad debe ser mayor a 0.");
            return;
        }

        String nombre = "";
        int precioUnitario = 0;

        switch (tipo) {
            case 1:
                nombre = "Boleta Plata";
                if (cantidad < 5) precioUnitario = 5000;
                else precioUnitario = 4500;
                break;

            case 2:
                nombre = "Boleta Oro";
                if (cantidad < 3) precioUnitario = 10000;
                else precioUnitario = 9000;
                break;

            case 3:
                nombre = "Boleta Diamante";
                if (cantidad < 2) precioUnitario = 20000;
                else precioUnitario = 18000;
                break;

            default:
                System.out.println("x Opción inválida.");
                return;
        }
        int total = precioUnitario * cantidad;
        System.out.println("\n=== RESUMEN DE COMPRA ===");
        System.out.println("Tipo de boleta: " + nombre);
        System.out.println("Cantidad: " + cantidad);
        System.out.println("Precio unitario: $" + precioUnitario);
        System.out.println("Total a pagar: $" + total);
    }
}





