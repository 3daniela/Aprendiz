import java.util.Scanner;

class Citas {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("=== CONTESTADOR DE CITAS MÉDICAS ===");

        System.out.println("1. Agendar cita");
        System.out.println("2. Detalles de la cita");
        System.out.println("3. Consultorio y hora");
        System.out.println("4. Cancelar cita");
        System.out.println("5. Historia clínica");
        System.out.println("6. Doctor asignado");
        System.out.println("7. Salir");

        System.out.print("Digite una opción: ");
        int opcion = sc.nextInt();

        switch (opcion) {

            case 1:
                System.out.println("Usted quiere agendar una cita.");
                break;

            case 2:
                System.out.println("Usted quiere ver los detalles de su cita.");
                break;

            case 3:
                System.out.println("Su consultorio asignado es el #3 a las 10:00 AM.");
                break;

            case 4:
                System.out.println("Usted quiere cancelar la cita.");
                break;

            case 5:
                System.out.println("Mostrando historia clínica...");
                break;

            case 6:
                System.out.println("Su doctor asignado es el Dr. Ramírez.");
                break;

            case 7:
                System.out.println("Saliendo... Gracias por usar el sistema.");
                break;

            default:
                System.out.println("x Opción no válida. Intente nuevamente.");
        }

        sc.close();
    }
}

