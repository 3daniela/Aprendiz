class suscripcion {
    static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("=== SUSCRIPCION AL GIMNACIO ===");
        System.out.println("1. Plan basico");
        System.out.println("2. Plan intermedio");
        System.out.println("3. Plan premium ");
        System.out.print("Seleccione una plan (1-3): ");
        int opcion = sc.nextInt();

        // VALIDACIÓN para que no se pase de 1 a 3
        if (opcion < 1 || opcion > 3) {
            System.out.println("Error: opción inválida. Debe ser entre 1 y 3.");
            return;
        }
        System.out.print("Ingrese la cantidad de meses: ");
        int meses = sc.nextInt();

        String nombrePlan = "";
        int precio = 0;

        int plan = 0;
        switch (plan) {

            case 2:
                nombrePlan = "Plan Intermedio";
                if (meses == 1) precio = 40000;
                else if (meses == 3) precio = 110000;
                else if (meses >= 6) precio = 200000;
                break;

            case 3:
                nombrePlan = "Plan Premium";
                if (meses == 1) precio = 60000;
                else if (meses == 3) precio = 160000;
                else if (meses >= 6) precio = 280000;
                break;

            default:
                System.out.println("x Opción de plan inválida.");
                return; // sale del programa
        }

        if (precio == 0) {
            System.out.println("x Cantidad de meses inválida.");
            return;
        }

        System.out.println("\n=== RESUMEN DE COMPRA ===");
        System.out.println("Plan seleccionado: " + nombrePlan);
        System.out.println("Meses: " + meses);
        System.out.println("Total a pagar: $" + precio);
    }
}







